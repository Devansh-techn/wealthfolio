# ---------- Browser (safe to expose; these ship in the JS bundle) ----------
# Supabase project URL and the PUBLIC anon key (Project Settings -> API).
# Never put the service_role key or any other secret in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public site URL (used for canonical/OpenGraph tags, robots.txt and sitemap.xml). Optional but recommended.
VITE_SITE_URL=https://your-domain.com
# Development only: set to "demo" to use SYNTHETIC prices while offline. Ignored in production builds.
# VITE_MARKET_PROVIDER=demo

# ---------- Server-side secrets (Supabase Edge Function secrets — NOT in this file at runtime) ----------
# Set with:  supabase secrets set --env-file ./supabase/.env.secrets   (do not commit that file)
# Comma-separated list of browser origins allowed to call the Edge Functions.
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173
# Optional: enables the "Explain with AI" button in the screener.
ANTHROPIC_API_KEY=
# Optional: override the model used for explanations.
ANTHROPIC_MODEL=claude-sonnet-5-5
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically.

# ---------- ML pipeline (ml/) — runs on YOUR machine / CI, never in the browser ----------
# Only needed for `python -m wealthfolio_ml predict --push` and `registry sync` (uploads model metadata/predictions).
# The service-role key bypasses RLS: keep it out of VITE_* variables and out of git.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
